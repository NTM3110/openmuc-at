<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<configuration>
  <driver id="virtual">
    <device id="serial_port">
      <description>Virtual Serial Ports</description>
      <disabled>false</disabled>
      <channel id="dev_serial_comm_number">
        <description>Virtual Serial Port Number</description>
        <valueType>INTEGER</valueType>
        <samplingInterval>2m</samplingInterval>
        <disabled>false</disabled>
      </channel>
      <channel id="dev_serial_comm_0">
        <description>Virtual Serial Port 0</description>
        <valueType length="128">STRING</valueType>
        <samplingInterval>2m</samplingInterval>
        <disabled>false</disabled>
      </channel>
      <channel id="dev_serial_comm_1">
        <description>Virtual Serial Port 1</description>
        <valueType length="128">STRING</valueType>
        <samplingInterval>2m</samplingInterval>
        <disabled>false</disabled>
      </channel>
      <channel id="dev_serial_comm_2">
        <description>Virtual Serial Port 2</description>
        <valueType length="128">STRING</valueType>
        <samplingInterval>2m</samplingInterval>
        <disabled>false</disabled>
      </channel>
    </device>
    <device id="virtual_site">
      <description>Site Name</description>
      <disabled>false</disabled>
      <channel id="site_name_1">
        <description>Site Name</description>
        <valueType length="64">STRING</valueType>
        <samplingInterval>2m</samplingInterval>
        <disabled>false</disabled>
      </channel>
    </device>
    <device id="account_manager">
      <description>Account Management</description>
      <disabled>false</disabled>
      <channel id="account_1_username">
        <description>Account 1 Username</description>
        <valueType length="128">STRING</valueType>
        <samplingInterval>2m</samplingInterval>
        <disabled>false</disabled>
      </channel>
      <channel id="account_1_password">
        <description>Account 1 Password</description>
        <valueType length="128">STRING</valueType>
        <samplingInterval>2m</samplingInterval>
        <disabled>false</disabled>
      </channel>
    </device>
  </driver>
  <driver id="modbus"/>
  <driver id="iec60870">
    <device id="lib60870_demo_server">
      <description>lib60870-C CS104 demo server on localhost:2404</description>
      <deviceAddress>h=192.168.4.58;p=2404;ca=1</deviceAddress>
      <settings>rt=5000</settings>
      <disabled>false</disabled>
      <channel id="iec60870_demo_me_nb_100">
        <description>Measured scaled value IOA 100</description>
        <channelAddress>ca=1;t=11;ioa=100</channelAddress>
        <valueType>INTEGER</valueType>
        <samplingInterval>5s</samplingInterval>
        <disabled>false</disabled>
      </channel>
      <channel id="iec60870_demo_me_nb_101">
        <description>Measured scaled value IOA 101</description>
        <channelAddress>ca=1;t=11;ioa=101</channelAddress>
        <valueType>INTEGER</valueType>
        <samplingInterval>5s</samplingInterval>
        <disabled>false</disabled>
      </channel>
      <channel id="iec60870_demo_me_nb_102">
        <description>Measured scaled value IOA 102</description>
        <channelAddress>ca=1;t=11;ioa=102</channelAddress>
        <valueType>INTEGER</valueType>
        <samplingInterval>5s</samplingInterval>
        <disabled>false</disabled>
      </channel>
      <channel id="iec60870_demo_sp_104">
        <description>Single point IOA 104</description>
        <channelAddress>ca=1;t=1;ioa=104</channelAddress>
        <valueType>BOOLEAN</valueType>
        <samplingInterval>5s</samplingInterval>
        <disabled>false</disabled>
      </channel>
      <channel id="iec60870_demo_sp_105">
        <description>Single point IOA 105</description>
        <channelAddress>ca=1;t=1;ioa=105</channelAddress>
        <valueType>BOOLEAN</valueType>
        <samplingInterval>5s</samplingInterval>
        <disabled>false</disabled>
      </channel>
      <channel id="iec60870_demo_me_nb_110">
        <description>Periodic measured scaled value IOA 110</description>
        <channelAddress>ca=1;t=11;ioa=110</channelAddress>
        <valueType>INTEGER</valueType>
        <samplingInterval>5s</samplingInterval>
        <disabled>false</disabled>
      </channel>
    </device>
  </driver>
</configuration>
